generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reviews {
  id Int @id @default(autoincrement())
  customer_name      String
  review_text      String
  sentiment      String
  confident_score      Int
  email     String   @unique
  createdAt DateTime @default(now())
}
