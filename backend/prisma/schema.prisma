generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbacks Feedback[]
}

model Feedback {
  id                String   @id @default(cuid())
  text              String
  sentiment         Sentiment?
  confidence        Float?
  urgencyScore      Float?
  source            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sentiment])
  @@index([urgencyScore])
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}
